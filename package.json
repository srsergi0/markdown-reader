{
	"name": "markdown-reader",
	"version": "2.0.2",
	"description": "Native Markdown reader with file association support",
	"author": "srsergi0",
	"main": "electron/main.js",
	"scripts": {
		"dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"electron .\"",
		"start": "vite build && electron .",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"dist": "vite build && electron-builder --publish never",
		"dist:win": "vite build && electron-builder --win --publish never",
		"dist:mac": "vite build && electron-builder --mac --publish never",
		"dist:linux": "vite build && electron-builder --linux --publish never",
		"register": "powershell -ExecutionPolicy Bypass -File scripts/register-dev.ps1"
	},
	"dependencies": {
		"electron-updater": "^6.8.9"
	},
	"devDependencies": {
		"@blocknote/core": "^0.51.4",
		"@blocknote/mantine": "^0.51.4",
		"@blocknote/react": "^0.51.4",
		"@mantine/core": "^8.3.11",
		"@mantine/hooks": "^8.3.11",
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"electron": "^44.2.0",
		"electron-builder": "^26.15.3",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.18.0",
		"mermaid": "^11.15.0",
		"postcss": "^8.4.49",
		"puppeteer-core": "^25.1.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^16.1.1",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"unified": "^11.0.5",
		"vite": "^6.0.3",
		"yallist": "^3.1.1"
	},
	"build": {
		"appId": "com.srsergi0.markdownreader",
		"productName": "Markdown Reader",
		"artifactName": "${name}-${version}-${arch}.${ext}",
		"directories": {
			"output": "artifacts"
		},
		"files": [
			"dist/**/*",
			"electron/**/*",
			"package.json"
		],
		"publish": [
			{
				"provider": "github",
				"owner": "srsergi0",
				"repo": "markdown-reader"
			}
		],
		"fileAssociations": [
			{
				"ext": ["md", "markdown"],
				"name": "Markdown Document",
				"role": "Viewer"
			}
		],
		"win": {
			"target": ["nsis", "zip"],
			"icon": "src/assets/icon.png"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"perMachine": false
		},
		"mac": {
			"target": ["dmg", "zip"],
			"icon": "src/assets/icon.png",
			"category": "public.app-category.productivity"
		},
		"linux": {
			"target": ["AppImage", "tar.gz"],
			"icon": "src/assets/icon.png",
			"category": "Office"
		}
	}
}
